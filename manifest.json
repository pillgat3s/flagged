{
    "manifest_version": 3,
    "name": "Flagged",
    "version": "1.1.1",
    "description": "See country flags on every X (Twitter) account. Filter your timeline by country — blur or hide posts.",
    "permissions": ["storage", "unlimitedStorage"],
    "icons": {
      "16": "icons/flagged_16.png",
      "32": "icons/flagged_32.png",
      "48": "icons/flagged_48.png",
      "128": "icons/flagged_128.png"
    },
    "host_permissions": [
      "https://x.com/*",
      "https://twitter.com/*",
      "https://flagged.pillgates777.workers.dev/*"
    ],
    "content_scripts": [
      {
        "matches": [
          "https://x.com/*",
          "https://twitter.com/*"
        ],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "action": {
      "default_title": "Flagged",
      "default_popup": "options.html",
      "default_icon": {
        "16": "icons/flagged_on.png",
        "32": "icons/flagged_on.png",
        "48": "icons/flagged_on.png",
        "128": "icons/flagged_on.png"
      }
    },
    "options_page": "options.html",
    "background": {
      "service_worker": "background.js",
      "scripts": ["background.js"]
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "pillgates.dev@gmail.com",
        "strict_min_version": "140.0",
        "data_collection_permissions": {
          "required": ["none"],
          "optional": []
        }
      }
    }
  }
